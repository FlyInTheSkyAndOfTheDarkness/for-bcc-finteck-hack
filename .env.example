# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.
# Бесплатный ключ Gemini: https://aistudio.google.com/ → Get API key → Create API key

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Быстрая модель для массовых проверок. Пусто → агент сам переберёт доступные Flash-модели
# (перебор занимает ~1,5 мин, поэтому лучше указать явно)
GEMINI_MODEL=gemini-3.5-flash-lite
# Сильная модель для рассуждений: противоречия, прогон сценариев, Critic, вопросы, итог.
# Пусто (по умолчанию) → всё делает GEMINI_MODEL с режимом размышлений high: ~3–4 мин на прогон,
# работает на бесплатном ключе. С gemini-3.5-flash прогон ~6+ мин, качество в пределах разброса
# (см. README → «Оценка качества»), но сильная модель быстрее исчерпывает суточную квоту.
LLM_STRONG_MODEL=
# LLM_STRONG_MODEL=gemini-3.5-flash
# LLM_STRONG_TAGS=set.,critic,clarify,verdict,answers
# Запасные модели при перегрузке (503), таймауте или исчерпании квоты, через запятую.
# Пусто → Flash той же или более ранней версии, затем Lite.
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# LLM_STRONG_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash-lite
# Через сколько секунд после ухода на запасную модель снова пробовать основную
# LLM_RECOVER_S=60
# Параллельных запросов внутри стадии
# REQCHECK_WORKERS=3

# Ограничение запросов в минуту (бесплатный тариф)
LLM_RPM=8
LLM_TEMPERATURE=0
# Режим размышлений Gemini: off | minimal | low | medium | high
LLM_THINKING=high
# Таймаут одного запроса, с (по умолчанию 300 для Flash, 120 для Lite)
# LLM_REQUEST_TIMEOUT=300

# Другие провайдеры (необязательно):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
