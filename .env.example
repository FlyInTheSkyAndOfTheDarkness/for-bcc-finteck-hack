# Скопируйте этот файл в .env и вставьте свой ключ. Файл .env в git не попадает.
# Бесплатный ключ Gemini: https://aistudio.google.com/ → Get API key → Create API key

LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Пусто → агент сам выберет актуальную Flash-модель, доступную ключу
GEMINI_MODEL=

# Ограничение запросов в минуту (бесплатный тариф)
LLM_RPM=8
LLM_TEMPERATURE=0

# Другие провайдеры (необязательно):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b
